{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"globalEnv": [
		"NODE_ENV",
		"DATABASE_URL",
		"BETTER_AUTH_SECRET",
		"GITHUB_CLIENT_ID",
		"GITHUB_CLIENT_SECRET",
		"GOOGLE_CLIENT_ID",
		"GOOGLE_CLIENT_SECRET",
		"NEXT_PUBLIC_APPWRITE_PROJECT_ID",
		"NEXT_PUBLIC_APPWRITE_ENDPOINT",
		"APPWRITE_API_KEY",
		"NEXT_PUBLIC_APP_ENV"
	],
	"tasks": {
		"dev": {
			"persistent": true,
			"cache": false
		},
		"dev:web": {
			"persistent": true,
			"cache": false
		},
		"dev:server": {
			"persistent": true,
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"build:web": {
			"dependsOn": ["^build:web"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"build:server": {
			"dependsOn": ["^build:server"],
			"outputs": ["dist/**"]
		},
		"compile:server": {
			"dependsOn": ["^compile:server"],
			"outputs": ["dist/**"]
		},
		"start": {
			"persistent": true,
			"cache": false
		},
		"start:web": {
			"persistent": true,
			"cache": false
		},
		"start:server": {
			"persistent": true,
			"cache": false
		},
		"db:generate": {
			"cache": false,
			"persistent": true
		},
		"db:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false,
			"persistent": true
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"check": {
			"dependsOn": ["^check"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"lint:fix": {
			"cache": false,
			"persistent": true
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"check-types:web": {
			"dependsOn": ["^check-types:web"]
		},
		"check-types:server": {
			"dependsOn": ["^check-types:server"]
		},
		"format:check": {
			"cache": false,
			"persistent": true
		},
		"format:write": {
			"cache": false,
			"persistent": true
		}
	}
}
